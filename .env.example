# Application
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-dev-secret-key-32bytes-min
JWT_SECRET_KEY=change-this-jwt-secret-in-production-dev-key

# Database
# For PostgreSQL in Docker / Production:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_to_audit_erp
# For SQLite (local fallback without docker):
# DATABASE_URL=sqlite:///order_to_audit.db

# Server Config
PORT=5000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend
VITE_API_URL=https://order-to-audit-erp-system-1bcl.onrender.com/api

# Supabase Storage (Backend-only credentials — NEVER expose to React)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

